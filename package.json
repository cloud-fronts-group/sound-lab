{
  "name": "sound-lab",
  "displayName": "Sound Lab — FFmpeg Audio Toolkit",
  "description": "Sound sampling, slicing, loudness, effects, spectrograms and speech-to-text transcription in VS Code, powered by FFmpeg.",
  "version": "0.1.0",
  "publisher": "sound-lab",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloud-fronts-group/sound-lab.git"
  },
  "homepage": "https://github.com/cloud-fronts-group/sound-lab#readme",
  "bugs": {
    "url": "https://github.com/cloud-fronts-group/sound-lab/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "ffmpeg",
    "audio",
    "sampling",
    "transcription",
    "whisper",
    "spectrogram",
    "waveform",
    "loudness",
    "subtitles"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.{wav,mp3,flac,ogg,opus,m4a,aac,aif,aiff,wma}"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "soundLab",
          "title": "Sound Lab",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "soundLab": [
        {
          "id": "soundLab.samples",
          "name": "Samples",
          "icon": "media/activity.svg"
        },
        {
          "type": "webview",
          "id": "soundLab.mlxPanel",
          "name": "MLX Audio",
          "icon": "media/activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "soundLab.samples",
        "contents": "No audio files found in this workspace.\n[Record Sample](command:soundLab.record)\n[Generate Tone / Noise](command:soundLab.generateTone)\n[Open Audio File…](command:soundLab.openPreview)"
      }
    ],
    "customEditors": [
      {
        "viewType": "soundLab.audioPreview",
        "displayName": "Sound Lab Audio Editor",
        "selector": [
          {
            "filenamePattern": "*.{wav,mp3,flac,ogg,oga,opus,m4a,aac,aif,aiff,wma,caf,ac3,amr,webm,mka}"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "soundLab.openPreview",
        "title": "Open in Audio Editor",
        "category": "Sound Lab",
        "icon": {
          "light": "media/icons/open-editor-light.svg",
          "dark": "media/icons/open-editor-dark.svg"
        }
      },
      {
        "command": "soundLab.probe",
        "title": "Show Media Info (ffprobe)",
        "category": "Sound Lab",
        "icon": {
          "light": "media/icons/info-light.svg",
          "dark": "media/icons/info-dark.svg"
        }
      },
      {
        "command": "soundLab.convert",
        "title": "Convert Format…",
        "category": "Sound Lab",
        "icon": {
          "light": "media/icons/convert-light.svg",
          "dark": "media/icons/convert-dark.svg"
        }
      },
      {
        "command": "soundLab.batchConvert",
        "title": "Batch Convert Folder…",
        "category": "Sound Lab",
        "icon": {
          "light": "media/icons/batch-convert-light.svg",
          "dark": "media/icons/batch-convert-dark.svg"
        }
      },
      {
