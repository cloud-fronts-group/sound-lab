    "submenus": [
      {
        "id": "soundLab.explorerMenu",
        "label": "Sound Lab"
      },
      {
        "id": "soundLab.djMenu",
        "label": "Sound Lab DJ"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "soundLab.explorerMenu",
          "group": "navigation@90",
          "when": "resourceExtname =~ /^\\.(wav|mp3|flac|ogg|oga|opus|m4a|aac|aif|aiff|wma|caf|ac3|amr|webm|mka|mp4|mov|mkv|avi|m4v|wmv|flv|ts|mts)$/i || explorerResourceIsFolder"
        }
      ],
      "soundLab.explorerMenu": [
        {
          "command": "soundLab.openPreview",
          "group": "1_open@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.probe",
          "group": "1_open@2",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.analyze",
          "group": "1_open@3",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.convert",
          "group": "2_edit@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.trim",
          "group": "2_edit@2",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.normalize",
          "group": "2_edit@3",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.applyEffects",
          "group": "2_edit@4",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.concat",
          "group": "2_edit@5",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.extractAudio",
          "group": "2_edit@6",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.sliceEqual",
          "group": "3_slice@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.splitOnSilence",
          "group": "3_slice@2",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.waveformImage",
          "group": "4_render@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.spectrogramImage",
          "group": "4_render@2",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.transcribe",
          "group": "5_speech@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.muxSubtitles",
          "group": "5_speech@2",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.recipes",
          "group": "6_other@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.batchConvert",
          "group": "7_folder@1",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "soundLab.record",
          "group": "7_folder@2",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "soundLab.generateTone",
          "group": "7_folder@3",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "soundLab.mlxSeparate",
          "group": "5_speech@3",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.autoTune",
          "group": "6_studio@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.layerOnto",
          "group": "6_studio@2",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "soundLab.detectTempoKey",
          "group": "6_studio@3",
          "when": "!explorerResourceIsFolder"
        },
        {
          "submenu": "soundLab.djMenu",
          "group": "6_studio@4",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "view/title": [
        {
          "command": "soundLab.record",
          "when": "view == soundLab.samples",
          "group": "navigation@1"
        },
        {
          "command": "soundLab.recipes",
          "when": "view == soundLab.samples",
          "group": "navigation@2"
        },
        {
          "command": "soundLab.refreshSamples",
          "when": "view == soundLab.samples",
          "group": "navigation@3"
        },
        {
          "command": "soundLab.generateTone",
          "when": "view == soundLab.samples",
          "group": "more@1"
        },
        {
          "command": "soundLab.batchConvert",
          "when": "view == soundLab.samples",
          "group": "more@2"
        },
        {
          "command": "soundLab.showCapabilities",
          "when": "view == soundLab.samples",
          "group": "more@3"
        },
        {
          "command": "soundLab.setApiKey",
          "when": "view == soundLab.samples",
          "group": "more@4"
        },
        {
          "command": "soundLab.showLog",
          "when": "view == soundLab.samples",
          "group": "more@5"
        },
        {
          "command": "soundLab.voiceClone",
          "when": "view == soundLab.mlxPanel",
          "group": "navigation@1"
        },
        {
          "command": "soundLab.mlxOpenStudio",
          "when": "view == soundLab.mlxPanel",
          "group": "navigation@2"
        },
        {
          "command": "soundLab.mlxModels",
          "when": "view == soundLab.mlxPanel",
          "group": "navigation@3"
        },
        {
          "command": "soundLab.mlxStart",
          "when": "view == soundLab.mlxPanel",
          "group": "more@1"
        },
        {
          "command": "soundLab.mlxStop",
          "when": "view == soundLab.mlxPanel",
          "group": "more@2"
        },
        {
          "command": "soundLab.mlxStopStudio",
          "when": "view == soundLab.mlxPanel",
          "group": "more@3"
        }
      ],
      "view/item/context": [
        {
          "command": "soundLab.openPreview",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "inline@1"
        },
        {
          "command": "soundLab.transcribe",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "inline@2"
        },
        {
          "command": "soundLab.probe",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "1_info@1"
        },
        {
          "command": "soundLab.analyze",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "1_info@2"
        },
        {
          "command": "soundLab.convert",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "2_edit@1"
        },
        {
          "command": "soundLab.trim",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "2_edit@2"
        },
        {
          "command": "soundLab.normalize",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "2_edit@3"
        },
        {
          "command": "soundLab.applyEffects",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "2_edit@4"
        },
        {
          "command": "soundLab.sliceEqual",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "3_slice@1"
        },
        {
          "command": "soundLab.splitOnSilence",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "3_slice@2"
        },
        {
          "command": "soundLab.spectrogramImage",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "4_render@1"
        },
        {
          "command": "soundLab.waveformImage",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "4_render@2"
        },
        {
          "command": "soundLab.transcribe",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "5_speech@1"
        },
        {
          "command": "soundLab.mlxSeparate",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "5_speech@2"
        },
        {
          "command": "soundLab.autoTune",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "6_studio@1"
        },
        {
          "submenu": "soundLab.djMenu",
          "when": "view == soundLab.samples && viewItem == soundLab.file",
          "group": "6_studio@2"
        }
      ],
      "editor/title": [
        {
          "command": "soundLab.transcribe",
          "when": "activeCustomEditorId == soundLab.audioPreview",
          "group": "navigation@1"
        },
        {
          "command": "soundLab.applyEffects",
          "when": "activeCustomEditorId == soundLab.audioPreview",
          "group": "navigation@2"
        },
        {
          "command": "soundLab.probe",
          "when": "activeCustomEditorId == soundLab.audioPreview",
          "group": "navigation@3"
        },
        {
          "command": "soundLab.voiceClone",
          "when": "activeCustomEditorId == soundLab.audioPreview",
          "group": "navigation@4"
        },
        {
          "command": "soundLab.openStudio",
          "when": "activeCustomEditorId == soundLab.audioPreview",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "soundLab.refreshSamples",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "soundLab.mlxSynthesize",
          "when": "editorHasSelection",
          "group": "9_soundlab@1"
        }
      ],
      "soundLab.djMenu": [
        {
          "command": "soundLab.djBackspin",
          "group": "1_fx@1"
        },
        {
          "command": "soundLab.djEchoOut",
          "group": "1_fx@2"
        },
        {
          "command": "soundLab.djBeatJump",
          "group": "1_fx@3"
        },
        {
          "command": "soundLab.djQuickMix",
          "group": "2_mix@1"
        },
        {
          "command": "soundLab.djLongBlend",
          "group": "2_mix@2"
        },
        {
          "command": "soundLab.djDoubleDrop",
          "group": "2_mix@3"
        },
        {
          "command": "soundLab.djMashup",
          "group": "2_mix@4"
        },
        {
          "command": "soundLab.djAcapella",
          "group": "3_stems@1"
        },
        {
          "command": "soundLab.djInstrumental",
          "group": "3_stems@2"
        }
      ]
    },
    "configuration": {
      "title": "Sound Lab",
      "properties": {
        "soundLab.ffmpegPath": {
          "type": "string",
          "default": "ffmpeg",
          "markdownDescription": "Path to the `ffmpeg` executable (or just `ffmpeg` if it is on your PATH)."
        },
        "soundLab.ffprobePath": {
          "type": "string",
          "default": "ffprobe",
          "markdownDescription": "Path to the `ffprobe` executable."
        },
        "soundLab.output.directory": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where results are written. Empty = next to the source file. Supports `${fileDirname}`, `${workspaceFolder}` and `${fileBasenameNoExtension}`."
        },
        "soundLab.output.overwrite": {
          "type": "boolean",
          "default": false,
          "description": "Overwrite existing output files instead of adding a numeric suffix."
        },
        "soundLab.defaults.format": {
          "type": "string",
          "enum": [
            "wav",
            "flac",
            "aiff",
            "mp3",
            "ogg",
            "opus",
            "m4a"
          ],
          "default": "wav",
          "description": "Default output format for samples and effects."
        },
        "soundLab.defaults.bitDepth": {
          "type": "number",
          "enum": [
            16,
            24,
            32
          ],
          "default": 24,
          "description": "Bit depth for WAV / AIFF / FLAC output (32 = float for WAV)."
        },
        "soundLab.defaults.sampleRate": {
          "type": "number",
          "default": 0,
          "description": "Output sample rate in Hz. 0 keeps the source rate."
        },
        "soundLab.defaults.mp3Bitrate": {
          "type": "string",
          "default": "320k",
          "description": "Bitrate for MP3 / AAC / Opus encoding."
        },
        "soundLab.normalize.targetLufs": {
          "type": "number",
          "default": -14,
          "description": "Integrated loudness target for EBU R128 normalization (LUFS). -14 streaming, -16 podcasts, -23 broadcast."
        },
        "soundLab.normalize.truePeak": {
          "type": "number",
          "default": -1,
          "description": "Maximum true peak (dBTP)."
        },
        "soundLab.normalize.lra": {
          "type": "number",
          "default": 11,
          "description": "Loudness range target (LU)."
        },
        "soundLab.silence.thresholdDb": {
          "type": "number",
          "default": -40,
          "description": "Level below which audio counts as silence (dBFS)."
        },
        "soundLab.silence.minDuration": {
          "type": "number",
          "default": 0.35,
          "description": "Minimum silence length (seconds) that splits a sample."
        },
        "soundLab.silence.padding": {
          "type": "number",
          "default": 0.03,
          "description": "Seconds of silence kept around each split segment."
        },
        "soundLab.silence.minSegment": {
          "type": "number",
          "default": 0.08,
          "description": "Discard segments shorter than this (seconds)."
        },
        "soundLab.preview.peaksPerSecond": {
          "type": "number",
          "default": 200,
          "description": "Waveform resolution in the audio editor."
        },
        "soundLab.explorer.include": {
          "type": "string",
          "default": "**/*.{wav,mp3,flac,ogg,oga,opus,m4a,aac,aif,aiff,wma,caf}",
          "description": "Glob of files listed in the Samples view."
        },
        "soundLab.explorer.exclude": {
          "type": "string",
          "default": "**/{node_modules,.git,out,dist}/**",
          "description": "Glob excluded from the Samples view."
        },
        "soundLab.record.inputFormat": {
          "type": "string",
          "default": "",
          "markdownDescription": "FFmpeg input device format for recording. Empty = auto (`avfoundation` on macOS, `dshow` on Windows, `pulse` on Linux)."
        },
        "soundLab.record.device": {
          "type": "string",
          "default": "",
          "markdownDescription": "Recording device. Empty = pick from a list each time (falls back to `default`)."
        },
        "soundLab.transcription.backend": {
          "type": "string",
          "enum": [
            "whisper.cpp",
            "openai-compatible",
            "ffmpeg-whisper",
            "mlx-audio"
          ],
          "enumDescriptions": [
            "Local whisper.cpp CLI (whisper-cli). Private, offline, needs a ggml model file.",
            "Any OpenAI-compatible /audio/transcriptions endpoint (OpenAI, Groq, faster-whisper-server, LocalAI…).",
            "FFmpeg 8+ built-in `whisper` audio filter (requires FFmpeg built with whisper.cpp).",
            "mlx-audio server (Sound Lab manages it): MLX Whisper / Parakeet on the Apple GPU natively, or on the CPU in a Docker/Podman/Apple container (mlx[cpu])."
          ],
          "default": "whisper.cpp",
          "description": "Speech-to-text engine."
        },
        "soundLab.transcription.language": {
          "type": "string",
          "default": "auto",
          "description": "Spoken language code (en, de, ja…) or 'auto'."
        },
        "soundLab.transcription.translateToEnglish": {
          "type": "boolean",
          "default": false,
          "description": "Translate speech to English instead of transcribing it verbatim."
        },
        "soundLab.transcription.prompt": {
          "type": "string",
          "default": "",
          "description": "Optional initial prompt (names, jargon) to guide recognition."
        },
        "soundLab.transcription.outputFormats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "srt",
              "vtt",
              "txt",
              "json"
            ]
          },
          "default": [
            "srt",
            "vtt",
            "txt",
            "json"
          ],
          "description": "Transcript files written next to the audio."
        },
        "soundLab.transcription.whisperCpp.executable": {
          "type": "string",
          "default": "whisper-cli",
          "description": "whisper.cpp CLI executable (whisper-cli, or main for older builds)."
        },
        "soundLab.transcription.whisperCpp.model": {
          "type": "string",
          "default": "",
          "description": "Path to a ggml model, e.g. ggml-base.en.bin."
        },
        "soundLab.transcription.whisperCpp.threads": {
          "type": "number",
          "default": 0,
          "description": "Threads for whisper.cpp (0 = its default)."
        },
        "soundLab.transcription.whisperCpp.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra CLI arguments for whisper.cpp."
        },
        "soundLab.transcription.ffmpegWhisper.model": {
          "type": "string",
          "default": "",
          "description": "ggml model path for FFmpeg's whisper filter."
        },
        "soundLab.transcription.openai.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Base URL of an OpenAI-compatible API."
        },
        "soundLab.transcription.openai.model": {
          "type": "string",
          "default": "whisper-1",
          "description": "Model name, e.g. whisper-1, whisper-large-v3 (Groq), Systran/faster-whisper-small."
        },
        "soundLab.mlx.mode": {
          "type": "string",
          "enum": [
            "auto",
            "native",
            "docker",
            "podman",
            "apple-container",
            "external"
          ],
          "default": "auto",
          "enumDescriptions": [
            "native on Apple Silicon, docker elsewhere",
            "Host Python `mlx_audio.server` — MLX on the Apple GPU (Metal)",
            "Docker image (mlx[cpu]) — CPU",
            "Podman image (mlx[cpu]) — CPU",
            "Apple `container` CLI (macOS 26) — CPU",
            "An mlx-audio server you run yourself at soundLab.mlx.url"
          ],
          "markdownDescription": "How Sound Lab runs the **mlx-audio** API server (STT, TTS, voice cloning, separation). Containers on macOS have no Metal access, so the Apple-GPU path is `native`."
        },
        "soundLab.mlx.url": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL of an mlx-audio server (mode `external`, or to override). Empty = `http://127.0.0.1:<port>`."
        },
        "soundLab.mlx.port": {
          "type": "number",
          "default": 8000,
          "description": "Port of the mlx-audio API server."
        },
        "soundLab.mlx.python": {
          "type": "string",
          "default": "python3",
          "markdownDescription": "Python with `mlx-audio[server]` installed (native mode), e.g. a venv's `bin/python`."
        },
        "soundLab.mlx.image": {
          "type": "string",
          "default": "",
          "markdownDescription": "Container image for docker/podman/apple-container. Empty = `ghcr.io/cloud-fronts-group/sound-lab-mlx-audio:cpu`."
        },
        "soundLab.mlx.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start the mlx-audio server automatically when a feature needs it."
        },
        "soundLab.mlx.stopOnExit": {
          "type": "boolean",
          "default": false,
          "description": "Stop a natively started mlx-audio server when VS Code closes."
        },
        "soundLab.mlx.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the mlx-audio server status in the status bar."
        },
        "soundLab.mlx.sttModel": {
          "type": "string",
          "default": "mlx-community/whisper-large-v3-turbo",
          "description": "Speech-to-text model for the mlx-audio backend."
        },
        "soundLab.mlx.ttsModel": {
          "type": "string",
          "default": "mlx-community/Kokoro-82M-bf16",
          "description": "Default text-to-speech model."
        },
        "soundLab.mlx.ttsVoice": {
          "type": "string",
          "default": "af_heart",
          "description": "Default voice for the text-to-speech model (Kokoro: af_heart, am_adam, bf_emma, bm_george…)."
        },
        "soundLab.mlx.cloneModel": {
          "type": "string",
          "default": "mlx-community/chatterbox-turbo-4bit",
          "description": "Default voice-cloning model (must accept a reference recording: Chatterbox, Qwen3-TTS Base, CSM, Spark, OuteTTS…)."
        },
        "soundLab.mlx.separationModel": {
          "type": "string",
          "default": "",
          "description": "Source-separation model id (empty = server default, mlx-community/sam-audio-large-fp16)."
        },
        "soundLab.mlx.studio.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder of mlx-audio Studio (`mlx_audio/ui`). Empty = find it in an editable mlx-audio install or download it on first use."
        },
        "soundLab.mlx.studio.port": {
          "type": "number",
          "default": 3000,
          "description": "Port for the mlx-audio Studio dev server."
        },
        "soundLab.studio.outputDirectory": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where Sound Lab Studio writes new instrumentals, beats, chords and sound effects. Empty = `sound-lab-studio/` in the first workspace folder (or `~/Sound Lab/Studio`). Relative paths are resolved against the workspace folder. Edits of a track (auto-tune, DJ moves) follow `soundLab.output.*`."
        },
        "soundLab.dj.separation": {
          "type": "string",
          "enum": [
            "auto",
            "mlx",
            "center"
          ],
          "enumDescriptions": [
            "mlx-audio AI separation when its server is running, otherwise center-channel extraction",
            "Always use mlx-audio (starts the server)",
            "Always use the built-in center-channel extractor (stereo files only)"
          ],
          "default": "auto",
          "description": "How DJ: Acapella / Instrumental and Mashup split vocals from music."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile",
    "test:ui": "npm run compile && node test/ui/harness.js && node test/ui/mlx-harness.js",
    "test:all": "npm test && node test/ui/harness.js"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.2.1",
    "typescript": "5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cloud-fronts-group/sound-lab.git"
  },
  "bugs": {
    "url": "https://github.com/cloud-fronts-group/sound-lab/issues"
  },
  "homepage": "https://github.com/cloud-fronts-group/sound-lab#readme"
}
