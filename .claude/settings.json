{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run compile)",
      "Bash(npm run watch)",
      "Bash(npm test)",
      "Bash(npm run test:ui)",
      "Bash(npm run test:all)",
      "Bash(npm run package)",
      "Bash(npx tsc:*)",
      "Bash(node --test:*)",
      "Bash(node test/ui/harness.js)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Bash(npx vsce publish:*)",
      "Bash(vsce publish:*)",
      "Bash(git push --force:*)",
      "Read(./.env)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-edit.js\"", "timeout": 60 }
        ]
      }
    ]
  }
}
